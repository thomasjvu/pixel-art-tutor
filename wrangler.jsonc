{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pixel-art-tutor-room",
  "main": "party/server.ts",
  "compatibility_date": "2026-08-26",
  "durable_objects": {
    "bindings": [
      {
        "name": "PixelRoom",
        "class_name": "PixelRoom"
      },
      {
        "name": "RoomDirectory",
        "class_name": "RoomDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PixelRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RoomDirectory"]
    }
  ]
}
