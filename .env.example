# Local: http://127.0.0.1:1999
# Production: your deployed PartyKit room worker host
VITE_PARTYKIT_HOST=http://127.0.0.1:1999

# Optional host/build override for the bundled Codex pet catalog.
# Accepted values include codex, dewey, seedy, fireball, stacky, rocky,
# null-signal, and bsod. The app defaults to codex when this is omitted.
VITE_CODEX_PET=codex
