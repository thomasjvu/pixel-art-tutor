{
  "name": "-pixel-art-tutor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "room:dev": "wrangler dev --config wrangler.jsonc --port 1999",
    "room:deploy": "wrangler deploy --config wrangler.jsonc",
    "build": "tsc -b && tsc -p tsconfig.worker.json --pretty false && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.worker.json --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify/json": "^2.2.520",
    "@iconify/react": "^4.1.1",
    "partysocket": "^1.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "partyserver": "^0.5.10",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "webmcp-types": "^0.1.5",
    "wrangler": "^4.126.0"
  }
}
